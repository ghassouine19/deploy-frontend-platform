# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET=change-me

# Local storage (used instead of S3/R2 for local dev)
LOCAL_STORAGE_PATH=./storage

# Database (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/deployments
# For very small tests you can use sqlite: sqlite:///./metadata.db

# Webhook & app
BACKEND_WEBHOOK_PATH=/webhook